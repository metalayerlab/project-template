[#!
  The Python layer's interface: every value the core needs from a language layer.
  Core files load it with
      [% import 'layers/' ~ language ~ '/layer.jinja' as layer with context %]
  and use [[ layer.<name> ]]. A new layer defines the same names (see layers/README.md).
!#]
[#! ---- identity ---- !#]
[% set name = 'Python' %]
[% set release_type = 'python' %]
[% set version_file = 'pyproject.toml' %]
[% set code_lang = 'python' %]
[% set topic = 'python' %]
[#! ---- commands (AGENTS.md, README, wiki, PR template) ---- !#]
[% set install = 'uv sync' %]
[% set add_dependency = '`uv add <pkg>` (dev: `uv add --dev <pkg>`)' %]
[% set lint = 'uv run ruff check' %]
[% set lint_fix = 'uv run ruff check --fix' %]
[% set format = 'uv run ruff format' %]
[% set format_check = 'uv run ruff format --check' %]
[% set typecheck = 'uv run mypy' %]
[% set test = 'uv run pytest' %]
[% set test_integration = 'RUN_INTEGRATION=1 uv run pytest -m integration' %]
[% set gen_wiki = 'uv run scripts/gen-wiki.py' %]
[% set run = 'uv run ' ~ project_name %]
[% set install_cli = 'uv tool install git+' ~ repo_url %]
[% set install_lib = 'uv add git+' ~ repo_url %]
[% set import_snippet = 'import ' ~ package_name %]
[% set public_api = package_name ~ ' (its __init__)' %]
[% set suppressions = '`noqa`/`type: ignore`' %]
[#! ---- what assistants must not read (AGENTS.md "Don't read"; .claude/settings.json denies) ---- !#]
[% set lock_file = 'uv.lock' %]
[% set deps_query = 'uv tree --depth 1' %]
[% set noread = ['.venv/', 'htmlcov/', '.coverage', '.mypy_cache/', '.ruff_cache/', '.pytest_cache/'] %]
[#! ---- source files the docs map and docs-touched check point at ---- !#]
[% set config_file = 'config.py' %]
[% set cli_file = 'cli.py' %]
[% set api_file = 'api.py' %]
[#! ---- release notes on the Release-Process page (empty if not needed) ---- !#]
[% set release_lock_note = '. A follow-up job refreshes `uv.lock` on the same PR' %]
[#! ---- container and host install ---- !#]
[% set runtime = 'Python' %]
[% set base_image = 'python' %]
[% set container_base = 'python:' ~ python_version ~ '-slim' %]
[% set container_bin_dir = '/opt/venv/bin' %]
[% set container_bin = '/opt/venv/bin/' ~ project_name %]
[% set systemd_upgrade = '`uv pip install --python /opt/' ~ project_name ~ ' git+' ~ repo_url ~ '@vX.Y.Z`' %]
