[#!
  The Obsidian layer: a vault of notes (design record 0016). Its only kind is `brain`,
  which drops releases, the wiki and the image, so those values are defined but never
  rendered. The vault is in `vault_dir` ("." for the repository root).
!#]
[#! ---- identity ---- !#]
[% set name = 'Obsidian' %]
[% set release_type = 'simple' %]
[% set version_file = 'version.txt' %]
[% set code_lang = 'markdown' %]
[% set topic = 'obsidian' %]
[#! the vault's path prefix in this layer's fragments: '' at the root, else 'knowledge/' !#]
[% set vault = '' if vault_dir == '.' else vault_dir ~ '/' %]
[#! ---- commands: the vault check, and the repository's own scripts/check.sh ---- !#]
[% set install = '' %]
[% set add_dependency = '' %]
[% set lint = 'uv run scripts/check-vault.py' %]
[% set lint_fix = '' %]
[% set format = '' %]
[% set format_check = '' %]
[% set typecheck = '' %]
[% set test = 'sh scripts/check.sh' %]
[% set test_integration = '' %]
[% set gen_wiki = '' %]
[#! ---- never rendered: a brain has no CLI, API or package ---- !#]
[% set run = '' %]
[% set install_cli = '' %]
[% set install_lib = '' %]
[% set import_snippet = '' %]
[% set public_api = '' %]
[% set suppressions = '' %]
[% set config_file = '' %]
[% set cli_file = '' %]
[% set api_file = '' %]
[#! ---- what assistants must not read ---- !#]
[% set lock_file = '' %]
[% set deps_query = '' %]
[% set noread = [vault ~ '.obsidian/', vault ~ '.trash/', vault ~ '_attachments/'] %]
[% set release_lock_note = '' %]
[#! ---- never rendered: no container image, no systemd unit ---- !#]
[% set runtime = '' %]
[% set base_image = '' %]
[% set container_base = '' %]
[% set runtime_base = container_base %]
[% set container_bin_dir = '' %]
[% set container_bin = '' %]
[% set systemd_upgrade = '' %]
