
if ! command -v npm >/dev/null 2>&1; then
    echo "npm is not installed: install Node.js >= [[ node_version ]], then re-run scripts/bootstrap.sh" >&2
    exit 1
fi
# Writes package-lock.json, and builds dist/ (the prepare script)
npm install --no-audit --no-fund --loglevel=error > /dev/null
# Fill the wiki's generated sections (settings, CLI, HTTP API) from the code.
node scripts/gen-wiki.ts > /dev/null
