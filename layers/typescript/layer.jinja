[#!
  The TypeScript layer's interface: every value the core needs from a language layer
  (layers/README.md). Node runs the .ts sources directly (type stripping); tsc builds dist/.
!#]
[#! ---- identity ---- !#]
[% set name = 'TypeScript' %]
[% set release_type = 'node' %]
[% set version_file = 'package.json' %]
[% set code_lang = 'typescript' %]
[#! ---- commands (AGENTS.md, README, wiki, PR template) ---- !#]
[% set install = 'npm ci' %]
[% set add_dependency = '`npm install <pkg>` (dev: `npm install -D <pkg>`)' %]
[% set lint = 'npm run lint' %]
[% set lint_fix = 'npm run lint -- --fix' %]
[% set format = 'npm run format' %]
[% set format_check = 'npm run format:check' %]
[% set typecheck = 'npm run typecheck' %]
[% set test = 'npm test' %]
[% set test_integration = 'npm run test:integration' %]
[% set gen_wiki = 'node scripts/gen-wiki.ts' %]
[% set run = 'npm start --' %]
[% set install_cli = 'npm install -g github:' ~ github_owner ~ '/' ~ project_name %]
[% set install_lib = 'npm install github:' ~ github_owner ~ '/' ~ project_name %]
[% set import_snippet = 'import { VERSION } from "' ~ project_name ~ '";' %]
[% set public_api = '`' ~ project_name ~ '` (`src/index.ts`)' %]
[% set suppressions = '`eslint-disable`/`@ts-expect-error`' %]
[#! ---- what assistants must not read (AGENTS.md "Don't read"; .claude/settings.json denies) ---- !#]
[% set lock_file = 'package-lock.json' %]
[% set deps_query = 'npm ls --depth 0' %]
[% set noread = ['node_modules/', 'dist/', 'coverage/'] %]
[#! ---- source files the docs map and docs-touched check point at ---- !#]
[% set config_file = 'config.ts' %]
[% set cli_file = 'cli.ts' %]
[% set api_file = 'api.ts' %]
[#! ---- release notes on the Release-Process page (empty if not needed) ---- !#]
[#! release-please's node strategy bumps package-lock.json with package.json: nothing to refresh. !#]
[% set release_lock_note = '' %]
[#! ---- container and host install ---- !#]
[% set runtime = 'Node.js' %]
[% set base_image = 'node' %]
[% set container_base = 'node:' ~ node_version ~ '-slim' %]
[% set container_bin_dir = '/app/bin' %]
[% set container_bin = '/app/bin/' ~ project_name %]
[% set systemd_upgrade = '`npm install -g --prefix /opt/' ~ project_name ~ ' github:' ~ github_owner ~ '/' ~ project_name ~ '#vX.Y.Z`' %]
