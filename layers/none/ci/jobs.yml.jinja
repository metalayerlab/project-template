
  test:
    name: Project checks
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: scripts/check.sh
        run: sh scripts/check.sh

  version:
    name: Version
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: version.txt matches the release manifest
        run: |
          VERSION=$(cat version.txt)
          MANIFEST=$(python3 -c 'import json; print(json.load(open(".release-please-manifest.json"))["."])')
          echo "version.txt: $VERSION, manifest: $MANIFEST"
          [ "$VERSION" = "$MANIFEST" ] \
            || { echo "::error::version.txt ($VERSION) and .release-please-manifest.json ($MANIFEST) disagree: only release-please changes them"; exit 1; }
