[#!
  The "none" layer: the core only, for a language without a layer yet (design record 0008).
  Every name the core reads is defined; most are empty, and the core skips an empty value.
  The project's own checks live in scripts/check.sh (project-owned).
!#]
[#! ---- identity ---- !#]
[% set name = 'None' %]
[% set release_type = 'simple' %]
[% set version_file = 'version.txt' %]
[% set code_lang = 'text' %]
[% set topic = '' %]
[#! ---- commands: only `test`; the rest are empty ---- !#]
[% set install = '' %]
[% set add_dependency = '' %]
[% set lint = '' %]
[% set lint_fix = '' %]
[% set format = '' %]
[% set format_check = '' %]
[% set typecheck = '' %]
[% set test = 'sh scripts/check.sh' %]
[% set test_integration = '' %]
[% set gen_wiki = '' %]
[#! ---- never rendered: kind is `other`, so no CLI, API or package ---- !#]
[% set run = '' %]
[% set install_cli = '' %]
[% set install_lib = '' %]
[% set import_snippet = '' %]
[% set public_api = '' %]
[% set suppressions = '`noqa`/`type: ignore`' %]
[% set config_file = '' %]
[% set cli_file = '' %]
[% set api_file = '' %]
[#! ---- nothing to keep out of context ---- !#]
[% set lock_file = '' %]
[% set deps_query = '' %]
[% set noread = [] %]
[% set release_lock_note = '' %]
[#! ---- never rendered: no container image, no systemd unit ---- !#]
[% set runtime = '' %]
[% set base_image = '' %]
[% set container_base = '' %]
[#! the runtime stage's image: the builder's, for every kind !#]
[% set runtime_base = container_base %]
[% set container_bin_dir = '' %]
[% set container_bin = '' %]
[% set systemd_upgrade = '' %]
