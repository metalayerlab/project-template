[% import 'layers/' ~ language ~ '/layer.jinja' as layer with context %]
# [[ project_name ]]. Install to /etc/systemd/system/[[ project_name ]].service; see the
# wiki's Deployment page (systemd). Template-owned skeleton: loosen the sandbox
# only with a comment saying why.
#
#   install -Dm644 contrib/systemd/[[ project_name ]].sysusers /usr/lib/sysusers.d/[[ project_name ]].conf
#   systemd-sysusers
[% include 'layers/' ~ language ~ '/systemd/install-comment.jinja' %]
#   install -Dm644 contrib/systemd/[[ project_name ]].service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now [[ project_name ]]
#
[% include 'layers/' ~ language ~ '/systemd/notes-comment.jinja' %]
[Unit]
Description=[[ project_name ]]: [[ description ]]
Documentation=[[ repo_url ]]/wiki
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=[[ project_name ]]
Group=[[ project_name ]]
ExecStart=/opt/[[ project_name ]]/bin/[[ project_name ]] serve -c /etc/[[ project_name ]]/config.yaml
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
Environment=TZ=[[ timezone ]]

# /var/lib/[[ project_name ]], the config's default state_dir
StateDirectory=[[ project_name ]]
StateDirectoryMode=0700
ConfigurationDirectory=[[ project_name ]]
UMask=0077

# Sandboxing: it serves HTTP on a TCP port and writes only its state.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
