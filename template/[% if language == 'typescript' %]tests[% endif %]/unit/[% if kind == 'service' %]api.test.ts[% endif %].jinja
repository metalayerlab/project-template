import { afterAll, expect, test } from "vitest";

import { createApp } from "../../src/api.ts";
import { loadConfig } from "../../src/config.ts";
import { VERSION } from "../../src/index.ts";

const app = await createApp(loadConfig("/nonexistent", {}));

afterAll(async () => {
  await app.close();
});

test("health", async () => {
  const response = await app.inject({ url: "[[ health_path ]]" });
  expect(response.statusCode).toBe(200);
  expect(response.json()).toEqual({ status: "ok" });
});

test("ready", async () => {
  expect((await app.inject({ url: "/readyz" })).json()).toEqual({ status: "ready" });
});

test("version", async () => {
  expect((await app.inject({ url: "/version" })).json()).toEqual({ version: VERSION });
});
