#!/usr/bin/env python3
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml>=6"]
# ///
"""Print the GitHub repositories the vault's notes follow: their `repos:` property.

Template-owned: changes come from project-template through `copier update` (design
record 0018). The Brain pull workflow's gate reads it: one `owner/name` per line, sorted.
`repos:` is one string or a list; an entry that isn't `owner/name` is a warning on stderr.

    uv run scripts/followed-repos.py [--vault DIR]
"""

from __future__ import annotations

import argparse
import re
import subprocess
import sys
from pathlib import Path

import yaml

REPO = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")


def notes(vault: Path) -> list[Path]:
    """The vault's notes as git sees them, without dot-folders and _templates/."""
    out = subprocess.run(
        ["git", "ls-files", "-co", "--exclude-standard", "-z", "--", "*.md"],
        cwd=vault, capture_output=True, text=True, check=True,
    ).stdout  # fmt: skip
    rels = [Path(p) for p in out.split("\0") if p]
    return [vault / p for p in rels if not any(x.startswith(".") or x == "_templates" for x in p.parts)]


def front_matter(text: str) -> object:
    if not text.startswith("---\n") or (end := text.find("\n---", 4)) == -1:
        return None
    try:
        return yaml.safe_load(text[4:end])
    except yaml.YAMLError:
        return None  # check-vault.py reports it


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--vault", default="[[ vault_dir ]]", help="the vault's folder (default: %(default)s)")
    args = parser.parse_args()
    vault = (Path(__file__).resolve().parents[1] / args.vault).resolve()
    found: set[str] = set()
    for path in notes(vault):
        props = front_matter(path.read_text(encoding="utf-8"))
        value = props.get("repos") if isinstance(props, dict) else None
        for entry in [value] if isinstance(value, str) else value if isinstance(value, list) else []:
            if isinstance(entry, str) and REPO.match(entry.strip()):
                found.add(entry.strip())
            elif entry:
                print(f"warning: {path.relative_to(vault)}: repos entry {entry!r} is not owner/name", file=sys.stderr)
    if found:
        print("\n".join(sorted(found)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
