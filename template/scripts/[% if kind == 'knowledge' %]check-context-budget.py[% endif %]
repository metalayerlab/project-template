#!/usr/bin/env python3
"""Check that the files every AI assistant session loads stay inside their context budget.

Template-owned: changes come from project-template through `copier update`. The budget is
the one projects with a wiki keep in their wiki standard (design records 0002 and 0006);
a knowledge repository has no wiki, so it is here (design record 0015). Raising it
is a change to project-template, never local. Stdlib only.

    python3 scripts/check-context-budget.py
"""

from __future__ import annotations

import sys
from pathlib import Path

# Characters (~4 per token).
BUDGET = {
    "AGENTS.md": 9000,
    "CLAUDE.md": 600,
    "GEMINI.md": 300,
    ".cursor/rules/project.mdc": 300,
    ".github/copilot-instructions.md": 700,
}


def main() -> int:
    root = Path(__file__).resolve().parents[1]
    errors = [
        f"error: {name}: {size} characters, over the context budget of {limit}: keep rules terse"
        for name, limit in BUDGET.items()
        if (path := root / name).is_file() and (size := len(path.read_text(encoding="utf-8"))) > limit
    ]
    # Quiet on a pass: an assistant reads this output on every run (design record 0007).
    print("\n".join(errors) if errors else "context budget OK")
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
