[% import 'layers/' ~ language ~ '/layer.jinja' as layer with context %]
# Template-owned. The same checks as CI, before each commit:
#   uv tool install pre-commit && pre-commit install -t pre-commit -t commit-msg
repos:
  - repo: local
    hooks:
[% include 'layers/' ~ language ~ '/pre-commit/hooks.yaml.jinja' %]
[% if kind == 'knowledge' %]
      - id: check-context-budget
        name: context budget
        entry: python3 scripts/check-context-budget.py
        language: system
        pass_filenames: false
        files: ^(AGENTS\.md|CLAUDE\.md|GEMINI\.md|\.cursor/|\.github/copilot-instructions\.md)
[% else %]
      - id: check-wiki
        name: wiki standard
        entry: python3 scripts/check-wiki.py
        language: system
        pass_filenames: false
        files: ^docs/wiki/
[% endif %]
  - repo: https://github.com/gitleaks/gitleaks
    rev: v8.30.1
    hooks:
      - id: gitleaks
[% if kind != 'knowledge' %]
  - repo: https://github.com/compilerla/conventional-pre-commit
    rev: v4.4.0
    hooks:
      - id: conventional-pre-commit
        stages: [commit-msg]
[% endif %]
