[% import 'layers/' ~ language ~ '/layer.jinja' as layer with context %]
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {"commit": "", "pr": "", "sessionUrl": false},
  "permissions": {
    "allow": [
[% include 'layers/' ~ language ~ '/claude/allow.json.jinja' %]
[% if container_image or contrib %]
      "Bash(scripts/check-manifests.sh)",
[% endif %]
[% if kind == 'knowledge' %]
      "Bash(python3 scripts/check-context-budget.py)",
[% else %]
      "Bash(python3 scripts/check-wiki.py:*)",
[% endif %]
      "Bash(scripts/check-docs-secrets.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
[% if kind != 'knowledge' %]
      "Edit(CHANGELOG.md)",
      "Edit(.release-please-manifest.json)",
[% endif %]
      "Edit(.copier-answers.yml)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main)",
      "Bash(git push *refs/heads/main *)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--tags*)",
      "Bash(git push *--follow-tags*)",
      "Bash(git tag:*)",
      "Bash(gh release:*)",
      "Bash(gh pr create *-R *)",
      "Bash(gh pr create *--repo*)",
[% include 'layers/' ~ language ~ '/claude/deny.json.jinja' %]
      "Read(./.graphify/**)",
      "Read(./graphify-out/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/repo-boundary.py\""}]
      }
    ]
  }
}
