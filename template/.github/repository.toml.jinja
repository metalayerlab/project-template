[% import 'layers/' ~ language ~ '/layer.jinja' as layer with context %]
# GitHub's About box. Project-owned: edit it, then apply it with
#   python3 scripts/repo-metadata.py
# CI warns on each push to main while GitHub differs from this file.
description = [[ description | tojson ]]
homepage = "[[ '' if kind == 'brain' else repo_url ~ '/wiki' ]]"
topics = [[ [layer.topic, kind] | select | reject('equalto', 'other') | list | tojson ]]
