[% import 'layers/' ~ language ~ '/layer.jinja' as layer with context %]
# Template-owned: change it in project-template and pull it in with `copier update`.
# Every job blocks the merge (make them required checks in branch protection).
name: CI

# Branches are checked through their PR: pushing to a branch with an open PR
# would otherwise run every job twice.
on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

jobs:
  secrets:
    name: Secret scan
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      # Allow-list false positives in .gitleaks.toml, never by disabling the job.
      # The image and arguments live in the script, so a local run matches this one.
      - name: gitleaks
        run: scripts/check-docs-secrets.sh secrets
[% if personal_data_guard %]

  personal-data:
    name: Personal data guard
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      # PERSONAL_DATA_DENYLIST is an optional repository secret: one string per line.
      - name: Scan tracked files
        env:
          PERSONAL_DATA_DENYLIST: ${{ secrets.PERSONAL_DATA_DENYLIST }}
        run: python3 scripts/check-personal-data.py
[% endif %]
[% include 'layers/' ~ language ~ '/ci/jobs.yml.jinja' %]
[% if kind == 'brain' %]

  repository:
    name: Repository metadata
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      # Projects with a wiki check this in their Wiki workflow; without one, it is its own job (0015).
      - name: .github/repository.toml is valid
        run: python3 scripts/repo-metadata.py --validate

  # A warning, not a failure: only a repository admin can fix it, outside any PR
  # (project-template design record 0010). An invalid file still fails.
  metadata:
    name: GitHub's About box
    if: github.event_name != 'pull_request' && github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: Matches .github/repository.toml?
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          rc=0; python3 scripts/repo-metadata.py --check || rc=$?
          if [ "$rc" = 1 ]; then
            echo "::warning::GitHub's About box differs from .github/repository.toml: run python3 scripts/repo-metadata.py"
          elif [ "$rc" != 0 ]; then exit "$rc"; fi
[% endif %]
[% if container_image or contrib %]

  manifests:
    name: Dockerfile and contrib manifests
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: Install validators
        run: |
          mkdir -p "$HOME/.local/bin"
[% if container_image %]
          curl -fsSL -o "$HOME/.local/bin/hadolint" \
            https://github.com/hadolint/hadolint/releases/download/v2.15.1/hadolint-linux-x86_64
          chmod +x "$HOME/.local/bin/hadolint"
[% endif %]
[% if 'k8s' in contrib %]
          curl -fsSL https://github.com/yannh/kubeconform/releases/download/v0.8.0/kubeconform-linux-amd64.tar.gz \
            | tar -xz -C "$HOME/.local/bin" kubeconform
[% endif %]
          echo "$HOME/.local/bin" >> "$GITHUB_PATH"
      - name: Validate
        run: scripts/check-manifests.sh
[% endif %]

  workflows:
    name: Workflow lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: actionlint
        run: docker run --rm -v "$PWD:/repo" -w /repo rhysd/actionlint:1.7.12 -color
